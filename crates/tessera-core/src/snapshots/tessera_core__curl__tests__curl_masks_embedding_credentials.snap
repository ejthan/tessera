---
source: crates/tessera-core/src/curl.rs
expression: out
---
curl -X POST 'http://localhost:8108/collections' \
  -H "X-TYPESENSE-API-KEY: $TYPESENSE_API_KEY" \
  --data-binary @- <<'EOF'
{
  "name": "c",
  "fields": [
    {
      "name": "emb",
      "type": "float[]",
      "embed": {
        "from": [
          "title"
        ],
        "model_config": {
          "model_name": "openai/text-embedding-3-small",
          "api_key": "••••",
          "access_token": "••••",
          "refresh_token": "••••",
          "client_secret": "••••"
        }
      }
    }
  ]
}
EOF
