let response = reqwest::Client::new()
    .get("https://ts.example.net:8443/collections/books/documents/search?q=dune&query_by=title&filter_by=genre%3A%3D%60a%20b%60%20%26%26%20year%3A%3E1")
    .header("X-TYPESENSE-API-KEY", std::env::var("TYPESENSE_API_KEY")?)
    .send()
    .await?;
println!("{}", response.text().await?);
