---
source: crates/tessera-core/src/search/export.rs
expression: "text(lang, &node(), &target)"
---
let response = reqwest::Client::new()
    .post("https://ts.example.net:8443/multi_search?page=2&per_page=5")
    .header("X-TYPESENSE-API-KEY", std::env::var("TYPESENSE_API_KEY")?)
    .header("Content-Type", "application/json")
    .body(r#"{
  "union": true,
  "searches": [
    {
      "collection": "a",
      "q": "*",
      "exhaustive": true,
      "n": null,
      "l": [
        1
      ]
    },
    {
      "collection": "b",
      "q": "*",
      "exhaustive": true,
      "n": null,
      "l": [
        1
      ]
    }
  ]
}"#)
    .send()
    .await?;
println!("{}", response.text().await?);
