  -H "X-TYPESENSE-API-KEY: $TYPESENSE_API_KEY" \
  --data-binary @- <<'EOF'
{
  "searches": [
    {
      "collection": "books",
      "q": "*",
      "filter_by": "aaa…"
    }
  ]
}
EOF
